# ===================================================================
# 幻境画廊 AI 绘图平台 — 环境变量配置
# ===================================================================
# 复制此文件为 .env 并填入真实值:
#   cp .env.example .env
#
# .env 文件已在 .gitignore 中排除，不会被推送到 Git 仓库。

# MySQL 数据库 root 用户密码
DB_PASSWORD=your_mysql_root_password

# JWT 签名密钥（HS256 算法，至少需要 32 个字符）
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars_long

# ComfyUI 服务器地址
COMFYUI_ADDRESS=http://your-comfyui-server:8188
